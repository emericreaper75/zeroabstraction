# PostgreSQL connection string
# For Docker Compose: postgresql://payload:payload@postgres:5432/payload
# For local dev: postgresql://payload:payload@127.0.0.1:5432/payload
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/payload

# Secret used to encrypt Payload auth tokens
# Generate a new one for production: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the app (used for CORS, redirects, etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
