{
  "name": "zeroabstraction",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "dev:app": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:host": "echo 'WARNING: Running directly on host is deprecated and unsupported. Use npm run dev (docker compose up --build).' && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "docker compose up",
    "start:app": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "payload:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "test:backend": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/verify-backend.ts",
    "test": "docker compose exec app npm run test:backend"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/lib-storage": "^3.1129.0",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "cross-env": "^10.1.0",
    "framer-motion": "^13.2.0",
    "graphql": "^16.14.2",
    "jose": "^6.2.12",
    "katex": "^0.18.7",
    "next": "^16.3.3",
    "next-view-transitions": "^0.3.5",
    "payload": "^3.88.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
