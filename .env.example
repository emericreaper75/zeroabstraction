# ==============================================================================
# ZEROABSTRACTION: ENVIRONMENT VARIABLES
# ==============================================================================
# DO NOT COMMIT REAL SECRETS. Copy this file to `.env` and fill in the values.

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL database connection string
# Used by Payload CMS and Drizzle ORM to connect to the database.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://username:password@localhost:5432/zeroabstraction

# ------------------------------------------------------------------------------
# PAYLOAD CMS
# ------------------------------------------------------------------------------
# Secret key used for signing sessions and cryptographic operations.
# Must be a long, random string (at least 32 characters).
# You can generate one using: openssl rand -base64 32
PAYLOAD_SECRET=your-secure-payload-secret-here

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
# The public URL of the application.
# Used by Payload for internal routing and Next.js for absolute URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# STORAGE (OPTIONAL)
# ------------------------------------------------------------------------------
# Credentials for S3-compatible storage (e.g. AWS S3, Cloudflare R2, MinIO)
# S3_ENDPOINT=https://your-s3-endpoint.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# EMAIL (OPTIONAL)
# ------------------------------------------------------------------------------
# SMTP credentials for sending emails (e.g. password resets, notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM_ADDRESS=noreply@zeroabstraction.dev
# SMTP_FROM_NAME="ZeroAbstraction"
