# ==============================================================================
# ZEROABSTRACTION: ENVIRONMENT VARIABLES
# ==============================================================================
# DO NOT COMMIT REAL SECRETS. Copy this file to `.env` and fill in the values.
# Note: Docker Compose is the ONLY supported local development workflow.

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (uses internal Docker network host:port)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/zeroabstraction

# ------------------------------------------------------------------------------
# PAYLOAD CMS
# ------------------------------------------------------------------------------
# Secret key used for signing sessions and cryptographic operations.
# Must be a long, random string (at least 32 characters).
# Generate via: openssl rand -base64 32
PAYLOAD_SECRET=your-secure-payload-secret-here

# Single local admin account (seeded on first boot; registration is closed)
ADMIN_EMAIL=admin@localhost.dev
ADMIN_PASSWORD=change-me-in-local-env

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
# The public URL of the application (single consolidated port: 3000)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# STORAGE (LOCAL DISK / S3 OBJECT STORAGE)
# ------------------------------------------------------------------------------
# In local development, media is stored on local disk under media/ (S3_ENABLED=false).
# In production, set S3_ENABLED=true and supply Cloudflare R2 / S3 credentials.
S3_ENABLED=false
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET=zeroabstraction-media
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# EMAIL (OPTIONAL)
# ------------------------------------------------------------------------------
# SMTP credentials for sending emails (e.g. password resets, notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM_ADDRESS=noreply@zeroabstraction.dev
# SMTP_FROM_NAME="ZeroAbstraction"
